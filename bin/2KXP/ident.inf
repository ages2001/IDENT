%Ide.DeviceDesc.amd64% = Ide_Inst, PCI\VEN_1078&DEV_0102&CC_01010F
%Ide.DeviceDesc.amd64% = Ide_Inst, PCI\VEN_1078&DEV_0102&CC_010105

;-------------------------------------------------------------------------------
;                    Install IDENT Service
;-------------------------------------------------------------------------------
;
; A controller in compatibility mode (class code 0101 with programming
; interface bits 0 and 2 clear) raises ISA IRQ 14 and 15, which the PCI bus
; driver does not report for it, and ScsiPort does not start a PCI adapter
; without an interrupt resource. The driver adds IRQ 14 to such a function's
; start request itself (idepnp.c); the function starts as one adapter, the
; primary channel interrupt-driven, the secondary with Fast Polling.

[Ide_Inst]
CopyFiles = Ide_CopyFiles
AddReg    = Ide_Inbox_AddReg

[Ide_Inst.Services]
AddService = IDENT, %SPSVCINST_ASSOCSERVICE%, Ide_Service_Inst, Miniport_EventLog_Inst

[Ide_Service_Inst]
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_BOOT_START%
ErrorControl   = %SERVICE_ERROR_NORMAL%
ServiceBinary  = %12%\IDENT.sys
LoadOrderGroup = SCSI Miniport
AddReg         = Ide_AddReg

[Ide_CopyFiles]
IDENT.sys

; The in-box IDE drivers are turned off: atapi (the channel driver), pciide
; and the chipset bus drivers that sit under it. A key that does not exist
; on this Windows version is created with Start alone, which no service
; uses. An IDE controller that appears later (new slot, new board) is
; started with IDENT instead of pciide.
[Ide_Inbox_AddReg]
HKLM,"System\CurrentControlSet\Services\atapi","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Services\pciide","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Services\intelide","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Services\viaide","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Services\cmdide","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Services\aliide","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Services\amdide","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Services\toside","Start",%REG_DWORD%,4
HKLM,"System\CurrentControlSet\Control\CriticalDeviceDatabase\pci#cc_0101","Service",,"IDENT"
HKLM,"System\CurrentControlSet\Control\CriticalDeviceDatabase\pci#cc_0101","ClassGUID",,"{4D36E97B-E325-11CE-BFC1-08002BE10318}"

[Miniport_EventLog_Inst]
AddReg = Miniport_EventLog_AddReg

[Miniport_EventLog_AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[Strings]
ProviderString       = "ages2001"
VendorString         = "Standard IDE Controller"
Ide.DeviceDesc.x86   = "IDENT PATA/SATA IDE Storage Controller"
Ide.DeviceDesc.amd64 = "IDENT PATA/SATA IDE Storage Controller (x64)"
DiskName             = "IDENT IDE Driver Disk"

; Service install flags
SPSVCINST_ASSOCSERVICE = 0x00000002

; Service Type
SERVICE_KERNEL_DRIVER  = 1

; Service Start Type
SERVICE_BOOT_START     = 0
SERVICE_SYSTEM_START   = 1
SERVICE_AUTO_START     = 2
SERVICE_DEMAND_START   = 3
SERVICE_DISABLED       = 4

; Service Error Control
SERVICE_ERROR_IGNORE   = 0
SERVICE_ERROR_NORMAL   = 1
SERVICE_ERROR_SEVERE   = 2
SERVICE_ERROR_CRITICAL = 3

; Registry types
REG_SZ         = 0x00000000
REG_MULTI_SZ   = 0x00010000
REG_EXPAND_SZ  = 0x00020000
REG_BINARY     = 0x00000001
REG_DWORD      = 0x00010001
REG_NONE       = 0x00020001
