; IDENT9X.INF
; Windows 9x Installation File for the IDENT PATA/SATA IDE Storage Controller Driver
; Copyright (c) 2026 ages2001
;
; Class hdc: the IDE controller's own class, so the INF is accepted for it
; from Device Manager (Change Driver / Have Disk). The miniport takes the
; whole controller (both channels) from the IDE port driver (ESDI_506.PDR). A controller in compatibility mode is driven with
; Fast Polling (the PCI device node carries no interrupt resource); IRQ=1 in
; the driver parameters connects the PCI interrupt of a native-mode controller.

[Version]
Signature="$CHICAGO"
Class=hdc
ClassGUID={4D36E96A-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderString%
DriverVer=10/19/2026,1.1.0.0

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,

[SourceDisksFiles]
IDENT9X.MPD = 1

[Manufacturer]
%VendorString%=IDE_Models

[IDE_Models]
; the class code with each programming interface, the plain class code,
; Silicon Image SATA controllers, and the mode-bearing IDs of the chips the
; in-box MSHDC.INF names by vendor and device (these rank above its entries)
