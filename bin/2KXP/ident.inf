[Version]
Signature="$Windows NT$"
Class=SCSIAdapter
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderString%
DriverVer=10/07/2026,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12  ; DIRID_DRIVERS

;-------------------------------------------------------------------------------
;                    Source disks
;-------------------------------------------------------------------------------

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksNames.x86]
1 = %DiskName%,,,\i386

[SourceDisksNames.amd64]
1 = %DiskName%,,,\amd64

[SourceDisksFiles]
IDENT.sys=1

[SourceDisksFiles.x86]
IDENT.sys=1

[SourceDisksFiles.amd64]
IDENT.sys=1

;-------------------------------------------------------------------------------
;                    Models
;-------------------------------------------------------------------------------

[Manufacturer]
%VendorString%=Ide_Models,NTx86,NTamd64

